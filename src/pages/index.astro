---
import BookingControls from "../components/BookingControls.astro";
import BookingSummary from "../components/BookingSummary.astro";
import CourtMap, { type CourtTile } from "../components/CourtMap.astro";
import IdentityBar from "../components/IdentityBar.astro";
import { isAnuStudent } from "../lib/anu-login";
import {
  bookedCourtIdsFor,
  DEMO_STUDENT_ID,
  hallLabelFor,
  isEligibleForFreeHour,
  isValidHallSlug,
  listCourtsForHall,
  type HallSlug,
} from "../lib/booking";
import { formatDateLong, isValidDate, isValidTimeSlot, TIME_SLOTS, todayIso } from "../lib/dates";
import "../styles.css";

const params = Astro.url.searchParams;

const hallParam = params.get("hall") ?? "";
const hallSlug: HallSlug = isValidHallSlug(hallParam) ? hallParam : "old";

const dateParam = params.get("date") ?? "";
const bookingDate = isValidDate(dateParam) ? dateParam : todayIso();

const timeParam = params.get("time") ?? "";
const startTime = isValidTimeSlot(timeParam) ? timeParam : TIME_SLOTS[0];

const courts = listCourtsForHall(hallSlug);
const bookedCourtIds = bookedCourtIdsFor(hallSlug, bookingDate, startTime);

const courtIdParam = Number(params.get("courtId"));
const selectedCourt =
  Number.isInteger(courtIdParam) && courtIdParam > 0
    ? courts.find((court) => court.id === courtIdParam && !bookedCourtIds.has(court.id))
    : undefined;

const tiles: CourtTile[] = courts.map((court) => ({
  id: court.id,
  courtNumber: court.courtNumber,
  name: court.name,
  state: bookedCourtIds.has(court.id) ? "booked" : court.id === selectedCourt?.id ? "selected" : "available",
}));

const hallLabel = hallLabelFor(hallSlug);
const dateLabel = formatDateLong(bookingDate);
const studentLoggedIn = await isAnuStudent(Astro.session);
const eligible = isEligibleForFreeHour(DEMO_STUDENT_ID, bookingDate, startTime, studentLoggedIn);

const errorParam = params.get("error");
const errorMessage =
  errorParam === "conflict"
    ? "That court was just booked by someone else for this time — please choose another court."
    : errorParam === "invalid"
      ? "That booking request wasn't valid — please check your selection and try again."
      : null;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ANU Badminton Court Booking</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Book a Court</a>
      <a href="/bookings/">My Bookings</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>ANU Badminton Court Booking</h1>

      <IdentityBar isAnuStudent={studentLoggedIn} returnTo={`${Astro.url.pathname}${Astro.url.search}`} />

      {errorMessage && <p role="alert" class="banner banner--error">{errorMessage}</p>}

      <BookingControls bookingDate={bookingDate} startTime={startTime} hallSlug={hallSlug} />

      <p class="free-hour-preview">
        Free Student Hour:{" "}
        {
          eligible ? (
            <strong>Eligible &mdash; $0.00</strong>
          ) : !studentLoggedIn ? (
            <strong>Log in as an ANU student to check eligibility</strong>
          ) : (
            <strong>Not eligible for this slot &mdash; student rate applies</strong>
          )
        }
      </p>

      <CourtMap hallLabel={hallLabel} tiles={tiles} bookingDate={bookingDate} startTime={startTime} hallSlug={hallSlug} />

      <BookingSummary
        hallLabel={hallLabel}
        bookingDate={bookingDate}
        dateLabel={dateLabel}
        startTime={startTime}
        eligible={eligible}
        selectedCourt={selectedCourt}
      />
    </main>
  </body>
</html>
